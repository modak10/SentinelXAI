# Copy this file to .env and adjust values for your machine.
# .env is gitignored — never commit real secrets or machine-specific paths.

# --- Application ---
ENV=development
LOG_LEVEL=INFO

# --- Paths (override configs/config.yaml defaults if needed) ---
DATA_RAW_DIR=data/raw/MachineLearningCVE
DATA_PROCESSED_DIR=data/processed
MODEL_PATH=models/lightgbm_model.pkl

# --- Future milestones (API / DB) ---
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/processed/predictions.db
