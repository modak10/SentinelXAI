# --- Data (never commit raw/interim/processed datasets) ---
data/raw/**
data/interim/**
data/processed/**
data/external/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
# Exception: these reports are small and are themselves reviewable
# artifacts (evidence of the pipeline's actual output), unlike the
# multi-hundred-MB parquet splits (including data/processed/engineered/)
# they summarize.
!data/processed/data_quality_report.json
!data/processed/feature_engineering_report.json

# --- Models / artifacts ---
models/**
!models/.gitkeep
*.pkl
*.joblib

# --- Logs ---
# Matches application.log, error.log, AND their rotated backups
# (application.log.1, .log.2, ...) created by RotatingFileHandler.
logs/*.log*
# reports/ (EDA figures, summaries, feature stats) is intentionally NOT
# ignored — those artifacts are small (<400KB total) and are themselves
# reviewable evidence of work done, unlike the raw/processed data.

# --- Secrets ---
.env

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ---
venv/
.venv/
env/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Claude Code local tooling state (machine-specific, not project source) ---
.claude/settings.local.json

# --- Agent memory/tooling state (machine-specific, not project source) ---
.workbuddy-ai/
